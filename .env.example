# LLM 配置
OPENAI_API_KEY=sk-your-key-here
# ANTHROPIC_API_KEY=sk-ant-your-key-here
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o

# 服务配置
PORT=3000
HOST=0.0.0.0

# 沙箱配置
SANDBOX_MEMORY_LIMIT=256m
SANDBOX_NETWORK_ENABLED=false
SANDBOX_WORK_DIR=.
SANDBOX_BACKEND=auto
NSJAIL_PATH=

# 安全配置
SAFETY_INPUT_GUARD=true
SAFETY_COMMAND_CONTROL=true
SAFETY_APPROVAL=true
SAFETY_OUTPUT_GUARD=true
SAFETY_ALLOW_LOCAL=true

# 记忆系统
MEMORY_DATA_DIR=./memory-data
MEMORY_SEMANTIC_BACKEND=file
CHROMADB_URL=http://localhost:8000

# Langfuse（可选）
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
